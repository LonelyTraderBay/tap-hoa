// apps/api/prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  owner
  store_manager
  cashier
}

enum PaymentMethod {
  cash
  transfer
  mixed
  debt
}

enum DebtLedgerType {
  sale_debt
  payment
  sale_return_credit
}

enum DebtPaymentChannel {
  cash
  transfer
}

enum CashDirection {
  in
  out
}

enum CashChannel {
  cash
  transfer
}

enum StockDocType {
  sale
  transfer
  stocktake
  purchase
  wastage
  sale_return
  supplier_return
}

enum TransferStatus {
  draft
  approved
  rejected
  received
}

enum PurchaseOrderStatus {
  draft
  ordered
  partial
  received
  closed
}

enum StocktakeLineReason {
  increase
  decrease
  match
}

enum WastageReason {
  spoilage
  damage
  other
}

enum EInvoiceStatus {
  draft
  pending_sign
  issued
  failed
  cancelled
  adjusted
}

model Store {
  id                String   @id @default(uuid())
  code              String   @unique
  name              String
  active            Boolean  @default(true)
  debtOverdueDays   Int      @default(30)
  largeDebtThresholdVnd Int?
  vatEnabled        Boolean  @default(false)
  defaultVatRateBps Int      @default(1000)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  users            UserStore[]
  products         ProductStoreStock[]
  sales            Sale[]
  shifts           Shift[]
  customers        Customer[]
  debtLedger       DebtLedgerEntry[]
  cashVouchers     CashVoucher[]
  stockTransfersFrom StockTransfer[] @relation("TransferFrom")
  stockTransfersTo   StockTransfer[] @relation("TransferTo")
  stocktakes         Stocktake[]
  purchaseOrders     PurchaseOrder[]
  purchaseReceipts   PurchaseReceipt[]
  supplierReturns    SupplierReturn[]
  wastageVouchers    WastageVoucher[]
  stockMovements     StockMovement[]
  saleReturns        SaleReturn[]
  supplierPayables   SupplierPayable[]
  supplierPayments   SupplierPayment[]
  bankStatementLines BankStatementLine[]
  bankReconLocks     BankReconLock[]
}

model User {
  id           String   @id @default(uuid())
  phone        String   @unique
  name         String
  passwordHash String
  role         Role
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  stores       UserStore[]
  shifts       Shift[]
  sales        Sale[]   @relation("SoldBy")
  debtLedger   DebtLedgerEntry[]
  cashVouchers CashVoucher[]
  transfersCreated  StockTransfer[] @relation("TransferCreatedBy")
  transfersApproved StockTransfer[] @relation("TransferApprovedBy")
  transfersReceived StockTransfer[] @relation("TransferReceivedBy")
  stocktakes        Stocktake[]
  purchaseOrders    PurchaseOrder[]
  purchaseReceipts  PurchaseReceipt[]
  supplierReturns   SupplierReturn[]
  wastageVouchers   WastageVoucher[]
  stockMovements    StockMovement[]
  saleReturns       SaleReturn[]
  pushTokens        DevicePushToken[]
  auditLogs         AuditLog[]
  supplierPayments  SupplierPayment[]
}

model UserStore {
  userId  String
  storeId String
  user    User  @relation(fields: [userId], references: [id])
  store   Store @relation(fields: [storeId], references: [id])
  @@id([userId, storeId])
}

model ProductGroup {
  id        String    @id @default(uuid())
  name      String
  sortOrder Int       @default(0)
  active    Boolean   @default(true)
  updatedAt DateTime  @updatedAt
  createdAt DateTime  @default(now())
  products  Product[]
}

model Product {
  id           String   @id @default(uuid())
  sku          String   @unique
  barcode      String?
  name         String
  unit         String
  sellUnit     String?
  packSize     Decimal? @db.Decimal(18, 3)
  kind         String   @default("normal") // normal | combo
  groupId      String?
  isWeighted   Boolean  @default(false)
  basePriceVnd Int
  costVnd      Int      @default(0)
  vatRateBps   Int?
  active       Boolean  @default(true)
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())
  group        ProductGroup? @relation(fields: [groupId], references: [id])
  stocks       ProductStoreStock[]
  transferLines StockTransferLine[]
  stocktakeLines StocktakeLine[]
  purchaseOrderLines PurchaseOrderLine[]
  purchaseLines  PurchaseReceiptLine[]
  saleLines      SaleLine[]
  supplierReturnLines SupplierReturnLine[]
  wastageLines   WastageVoucherLine[]
  stockMovements StockMovement[]
  comboComponents ProductComboComponent[] @relation("ComboProduct")
  usedInCombos    ProductComboComponent[] @relation("ComponentProduct")
}

model ProductComboComponent {
  id                 String  @id @default(uuid())
  comboProductId     String
  componentProductId String
  qtyBase            Decimal @db.Decimal(18, 3)
  comboProduct       Product @relation("ComboProduct", fields: [comboProductId], references: [id])
  componentProduct   Product @relation("ComponentProduct", fields: [componentProductId], references: [id])

  @@unique([comboProductId, componentProductId])
  @@index([comboProductId])
}

model ProductStoreStock {
  productId      String
  storeId        String
  qty            Decimal  @db.Decimal(18, 3)
  minQty         Decimal  @default(0) @db.Decimal(18, 3)
  avgCostVnd     Int      @default(0)
  updatedAt      DateTime @updatedAt
  product        Product  @relation(fields: [productId], references: [id])
  store          Store    @relation(fields: [storeId], references: [id])
  @@id([productId, storeId])
}

model Shift {
  id                  String    @id @default(uuid())
  storeId             String
  userId              String
  openedAt            DateTime
  closedAt            DateTime?
  openingCash         Int
  closingCash         Int?
  expectedCashVnd     Int?
  varianceVnd         Int?
  transferInShiftVnd  Int?
  note                String?
  store               Store     @relation(fields: [storeId], references: [id])
  user                User      @relation(fields: [userId], references: [id])
  sales               Sale[]
  cashVouchers        CashVoucher[]
}

model Customer {
  id              String            @id @default(uuid())
  storeId         String
  name            String
  phone           String?
  balanceVnd      Int               @default(0)
  creditLimitVnd  Int?
  updatedAt       DateTime          @updatedAt
  createdAt       DateTime          @default(now())
  store           Store             @relation(fields: [storeId], references: [id])
  sales           Sale[]
  debtLedger      DebtLedgerEntry[]
  @@index([storeId])
}

model DebtLedgerEntry {
  id              String               @id @default(uuid())
  storeId         String
  customerId      String
  type            DebtLedgerType
  amountVnd       Int
  balanceAfterVnd Int
  saleId          String?              @unique
  shiftId         String?
  recordedById    String
  paymentMethod   DebtPaymentChannel?
  note            String?
  clientCreatedAt DateTime
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  store           Store                @relation(fields: [storeId], references: [id])
  customer        Customer             @relation(fields: [customerId], references: [id])
  sale            Sale?                @relation(fields: [saleId], references: [id])
  recordedBy      User                 @relation(fields: [recordedById], references: [id])
  @@index([storeId, clientCreatedAt])
  @@index([customerId, clientCreatedAt])
}

model Sale {
  id             String        @id @default(uuid())
  storeId        String
  shiftId        String
  soldById       String
  paymentMethod  PaymentMethod
  cashAmount     Int           @default(0)
  transferAmount Int           @default(0)
  debtAmount     Int           @default(0)
  discountVnd    Int           @default(0)
  totalVnd       Int
  customerId     String?
  clientCreatedAt DateTime
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  store          Store         @relation(fields: [storeId], references: [id])
  shift          Shift         @relation(fields: [shiftId], references: [id])
  soldBy         User          @relation("SoldBy", fields: [soldById], references: [id])
  customer       Customer?     @relation(fields: [customerId], references: [id])
  lines          SaleLine[]
  debtLedger     DebtLedgerEntry?
  returns        SaleReturn[]
  eInvoices      EInvoice[]
  eInvoiceLinks  EInvoiceSale[]
  @@index([storeId, clientCreatedAt])
}

model SaleLine {
  id          String  @id @default(uuid())
  saleId      String
  productId   String
  qty         Decimal @db.Decimal(18, 3)
  unitPrice   Int
  discountVnd Int     @default(0)
  lineTotal   Int
  unitCostVnd Int?
  /** Snapshot at sale time: Product.vatRateBps ?? Store.default when VAT on. */
  vatRateBps  Int?
  netVnd      Int?
  vatVnd      Int?
  sale        Sale    @relation(fields: [saleId], references: [id])
  product     Product @relation(fields: [productId], references: [id])
  @@index([productId])
}

model SaleReturn {
  id              String   @id @default(uuid())
  storeId         String
  originalSaleId  String
  shiftId         String?
  recordedById    String
  cashRefundVnd   Int      @default(0)
  transferRefundVnd Int    @default(0)
  debtCreditVnd   Int      @default(0)
  totalRefundVnd  Int
  note            String?
  clientCreatedAt DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  store           Store    @relation(fields: [storeId], references: [id])
  originalSale    Sale     @relation(fields: [originalSaleId], references: [id])
  recordedBy      User     @relation(fields: [recordedById], references: [id])
  lines           SaleReturnLine[]
  @@index([storeId, clientCreatedAt])
  @@index([originalSaleId])
}

model SaleReturnLine {
  id            String     @id @default(uuid())
  returnId      String
  productId     String
  qty           Decimal    @db.Decimal(18, 3)
  unitPrice     Int
  lineRefundVnd Int
  /** Snapshot at return time: prefer original sale line snapshot. */
  vatRateBps    Int?
  netVnd        Int?
  vatVnd        Int?
  saleReturn    SaleReturn @relation(fields: [returnId], references: [id])
}

model SyncCursor {
  deviceId   String   @id
  userId     String
  storeId    String?
  lastPullAt DateTime
  lastPushAt DateTime?
  userAgent  String?
}

model DevicePushToken {
  id        String   @id @default(uuid())
  deviceId  String
  userId    String
  token     String
  platform  String
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  @@unique([deviceId])
  @@index([userId])
}

model CashCategory {
  id        String        @id @default(uuid())
  code      String        @unique
  name      String
  direction CashDirection
  sortOrder Int           @default(0)
  vouchers  CashVoucher[]
}

model CashVoucher {
  id              String        @id @default(uuid())
  storeId         String
  shiftId         String
  categoryId      String
  direction       CashDirection
  channel         CashChannel
  amountVnd       Int
  note            String?
  recordedById    String
  clientCreatedAt DateTime
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  store           Store         @relation(fields: [storeId], references: [id])
  shift           Shift         @relation(fields: [shiftId], references: [id])
  category        CashCategory  @relation(fields: [categoryId], references: [id])
  recordedBy      User          @relation(fields: [recordedById], references: [id])
  @@index([storeId, clientCreatedAt])
  @@index([shiftId, clientCreatedAt])
}

model StockTransfer {
  id              String         @id @default(uuid())
  fromStoreId     String
  toStoreId       String
  status          TransferStatus @default(draft)
  note            String?
  createdById     String
  approvedById    String?
  receivedById    String?
  clientCreatedAt DateTime
  approvedAt      DateTime?
  receivedAt      DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  fromStore       Store          @relation("TransferFrom", fields: [fromStoreId], references: [id])
  toStore         Store          @relation("TransferTo", fields: [toStoreId], references: [id])
  createdBy       User           @relation("TransferCreatedBy", fields: [createdById], references: [id])
  approvedBy      User?          @relation("TransferApprovedBy", fields: [approvedById], references: [id])
  receivedBy      User?          @relation("TransferReceivedBy", fields: [receivedById], references: [id])
  lines           StockTransferLine[]
  @@index([fromStoreId, updatedAt])
  @@index([toStoreId, updatedAt])
}

model StockTransferLine {
  id         String        @id @default(uuid())
  transferId String
  productId  String
  qty        Decimal       @db.Decimal(18, 3)
  unitCostVnd Int?
  transfer   StockTransfer @relation(fields: [transferId], references: [id])
  product    Product       @relation(fields: [productId], references: [id])
  @@index([transferId])
}

model Stocktake {
  id              String   @id @default(uuid())
  storeId         String
  note            String?
  recordedById    String
  clientCreatedAt DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  store           Store    @relation(fields: [storeId], references: [id])
  recordedBy      User     @relation(fields: [recordedById], references: [id])
  lines           StocktakeLine[]
  @@index([storeId, clientCreatedAt])
}

model StocktakeLine {
  id          String              @id @default(uuid())
  stocktakeId String
  productId   String
  systemQty   Decimal             @db.Decimal(18, 3)
  countedQty  Decimal             @db.Decimal(18, 3)
  varianceQty Decimal             @db.Decimal(18, 3)
  reason      StocktakeLineReason
  reasonNote  String?
  stocktake   Stocktake           @relation(fields: [stocktakeId], references: [id])
  product     Product             @relation(fields: [productId], references: [id])
  @@index([stocktakeId])
}

model PurchaseOrder {
  id              String              @id @default(uuid())
  storeId         String
  supplierName    String
  supplierPhone   String?
  supplierId      String?
  status          PurchaseOrderStatus @default(draft)
  note            String?
  createdById     String
  clientCreatedAt DateTime
  orderedAt       DateTime?
  closedAt        DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  store           Store               @relation(fields: [storeId], references: [id])
  supplier        Supplier?           @relation(fields: [supplierId], references: [id])
  createdBy       User                @relation(fields: [createdById], references: [id])
  lines           PurchaseOrderLine[]
  receipts        PurchaseReceipt[]
  @@index([storeId, updatedAt])
  @@index([storeId, status])
  @@index([supplierId])
}

model PurchaseOrderLine {
  id              String        @id @default(uuid())
  purchaseOrderId String
  productId       String
  qty             Decimal       @db.Decimal(18, 3)
  receivedQty     Decimal       @default(0) @db.Decimal(18, 3)
  unitCostVnd     Int?
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product         Product       @relation(fields: [productId], references: [id])
  @@index([purchaseOrderId])
  @@index([productId])
}

model PurchaseReceipt {
  id              String   @id @default(uuid())
  storeId         String
  supplierName    String
  supplierPhone   String?
  supplierId      String?
  purchaseOrderId String?
  note            String?
  recordedById    String
  clientCreatedAt DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  store           Store    @relation(fields: [storeId], references: [id])
  recordedBy      User     @relation(fields: [recordedById], references: [id])
  supplier        Supplier? @relation(fields: [supplierId], references: [id])
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  lines           PurchaseReceiptLine[]
  payable         SupplierPayable?
  @@index([storeId, clientCreatedAt])
  @@index([purchaseOrderId])
}

model PurchaseReceiptLine {
  id         String          @id @default(uuid())
  receiptId  String
  productId  String
  qty        Decimal         @db.Decimal(18, 3)
  unitCostVnd Int?
  /** Snapshot at receipt time (inclusive split). */
  vatRateBps  Int?
  netVnd      Int?
  vatVnd      Int?
  receipt    PurchaseReceipt @relation(fields: [receiptId], references: [id])
  product    Product         @relation(fields: [productId], references: [id])
  @@index([receiptId])
}

model WastageVoucher {
  id              String        @id @default(uuid())
  storeId         String
  reasonCode      WastageReason
  note            String?
  recordedById    String
  clientCreatedAt DateTime
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  store           Store         @relation(fields: [storeId], references: [id])
  recordedBy      User          @relation(fields: [recordedById], references: [id])
  lines           WastageVoucherLine[]
  @@index([storeId, clientCreatedAt])
}

model WastageVoucherLine {
  id        String         @id @default(uuid())
  wastageId String
  productId String
  qty       Decimal        @db.Decimal(18, 3)
  wastage   WastageVoucher @relation(fields: [wastageId], references: [id])
  product   Product        @relation(fields: [productId], references: [id])
  @@index([wastageId])
}

model StockMovement {
  id              String       @id @default(uuid())
  storeId         String
  productId       String
  qtyDelta        Decimal      @db.Decimal(18, 3)
  balanceAfter    Decimal      @db.Decimal(18, 3)
  docType         StockDocType
  docId           String
  docLineId       String?
  recordedById    String
  clientCreatedAt DateTime
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  store           Store        @relation(fields: [storeId], references: [id])
  product         Product      @relation(fields: [productId], references: [id])
  recordedBy      User         @relation(fields: [recordedById], references: [id])
  @@index([storeId, clientCreatedAt])
  @@index([productId, clientCreatedAt])
  @@index([docId])
}

enum AccountType {
  asset
  liability
  equity
  revenue
  expense
}

model Account {
  code      String      @id
  name      String
  type      AccountType
  active    Boolean     @default(true)
  createdAt DateTime    @default(now())
  lines     JournalLine[]
}

model JournalEntry {
  id         String   @id @default(uuid())
  storeId    String?
  periodYm   String
  sourceType String
  sourceId   String
  postedAt   DateTime @default(now())
  memo       String?
  lines      JournalLine[]
  @@unique([sourceType, sourceId])
  @@index([periodYm, postedAt])
  @@index([storeId, postedAt])
}

model JournalLine {
  id          String       @id @default(uuid())
  entryId     String
  accountCode String
  debitVnd    Int          @default(0)
  creditVnd   Int          @default(0)
  entry       JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  account     Account      @relation(fields: [accountCode], references: [code])
  @@index([entryId])
  @@index([accountCode])
}

model PeriodLock {
  periodYm   String   @id
  lockedAt   DateTime @default(now())
  lockedById String?
}

model AuditLog {
  id          String   @id @default(uuid())
  actorUserId String?
  action      String
  entityType  String
  entityId    String?
  detailJson  String?
  at          DateTime @default(now())
  actor       User?    @relation(fields: [actorUserId], references: [id])
  @@index([at])
  @@index([entityType, entityId])
}

model Supplier {
  id        String   @id @default(uuid())
  name      String
  phone     String?
  note      String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  receipts  PurchaseReceipt[]
  purchaseOrders PurchaseOrder[]
  returns   SupplierReturn[]
  payables  SupplierPayable[]
  payments  SupplierPayment[]
}

/** Return goods to supplier — reduces stock and AP (gross). */
model SupplierReturn {
  id              String   @id @default(uuid())
  storeId         String
  supplierId      String
  purchaseReceiptId String?
  clientId        String?
  note            String?
  amountVnd       Int
  recordedById    String
  clientCreatedAt DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  store           Store    @relation(fields: [storeId], references: [id])
  supplier        Supplier @relation(fields: [supplierId], references: [id])
  recordedBy      User     @relation(fields: [recordedById], references: [id])
  lines           SupplierReturnLine[]
  @@unique([storeId, clientId])
  @@index([storeId, clientCreatedAt])
  @@index([supplierId])
  @@index([purchaseReceiptId])
}

model SupplierReturnLine {
  id          String         @id @default(uuid())
  returnId    String
  productId   String
  qty         Decimal        @db.Decimal(18, 3)
  unitCostVnd Int
  purchaseReceiptLineId String?
  vatRateBps  Int?
  netVnd      Int?
  vatVnd      Int?
  supplierReturn SupplierReturn @relation(fields: [returnId], references: [id])
  product     Product        @relation(fields: [productId], references: [id])
  @@index([returnId])
}

model BankAccount {
  id        String   @id @default(uuid())
  name      String
  bankName  String?
  accountNo String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  statementLines BankStatementLine[]
}

/** Imported bank statement line for transfer reconciliation. */
model BankStatementLine {
  id            String   @id @default(uuid())
  storeId       String
  bankAccountId String?
  periodYm      String
  bookedAt      DateTime
  amountVnd     Int
  memo          String?
  matchedRef    String?
  /** Idempotency key for CSV re-import (store-scoped). */
  fingerprint   String?
  matchVersion  Int      @default(0)
  createdAt     DateTime @default(now())
  store         Store    @relation(fields: [storeId], references: [id])
  bankAccount   BankAccount? @relation(fields: [bankAccountId], references: [id])
  @@unique([storeId, fingerprint])
  @@index([storeId, periodYm])
}

model BankReconLock {
  id         String   @id @default(uuid())
  storeId    String
  periodYm   String
  lockedById String
  lockedAt   DateTime @default(now())
  store      Store    @relation(fields: [storeId], references: [id])
  @@unique([storeId, periodYm])
}

model SupplierPayable {
  id                String   @id @default(uuid())
  supplierId        String
  storeId           String
  purchaseReceiptId String?  @unique
  amountVnd         Int
  balanceVnd        Int
  clientCreatedAt   DateTime
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  supplier          Supplier @relation(fields: [supplierId], references: [id])
  store             Store    @relation(fields: [storeId], references: [id])
  purchaseReceipt   PurchaseReceipt? @relation(fields: [purchaseReceiptId], references: [id])
  @@index([supplierId])
  @@index([storeId])
}

model SupplierPayment {
  id              String      @id @default(uuid())
  supplierId      String
  storeId         String
  amountVnd       Int
  channel         CashChannel
  bankAccountId   String?
  note            String?
  recordedById    String
  clientCreatedAt DateTime
  createdAt       DateTime    @default(now())
  supplier        Supplier    @relation(fields: [supplierId], references: [id])
  store           Store       @relation(fields: [storeId], references: [id])
  recordedBy      User        @relation(fields: [recordedById], references: [id])
  @@index([supplierId])
}

model EInvoice {
  id              String         @id @default(uuid())
  saleId          String
  status          EInvoiceStatus @default(draft)
  buyerTaxCode    String?
  templateCode    String?
  serial          String?
  invoiceNumber   String?
  provider        String
  providerRef     String?
  xmlPath         String?
  pdfPath         String?
  errorMessage    String?
  retryCount      Int            @default(0)
  lastAttemptAt   DateTime?
  issuedAt        DateTime?
  adjustmentForId String?
  adjustmentReason String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  sale            Sale           @relation(fields: [saleId], references: [id])
  saleLinks       EInvoiceSale[]
  adjustmentFor   EInvoice?      @relation("EInvoiceAdjustments", fields: [adjustmentForId], references: [id])
  adjustments     EInvoice[]     @relation("EInvoiceAdjustments")
  @@index([status])
  @@index([saleId])
  @@index([adjustmentForId])
}

model EInvoiceSale {
  invoiceId   String
  saleId      String
  isAdjustment Boolean @default(false)
  claimActive Boolean @default(true)
  claimKey    String?  @unique
  invoice     EInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  sale        Sale     @relation(fields: [saleId], references: [id])

  @@id([invoiceId, saleId])
  @@index([saleId])
  @@index([saleId, isAdjustment, claimActive])
}
