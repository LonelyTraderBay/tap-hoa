# tap-hoa — LOCAL DB IS SUPABASE ONLY (project_id=tap-hoa)
# Locked by apps/api/src/config/tap-hoa.identity.ts when NODE_ENV != production
# Run: .\scripts\dev-up.ps1  (writes .env via write-tap-hoa-env.ps1)
#
# Do NOT use Docker Compose Postgres for local (removed). Do NOT use port 54322.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54422/tap_hoa?schema=public
JWT_SECRET=dev-change-me-tap-hoa
PORT=3040

# Production (VPS / commercial) — identity lock skipped when NODE_ENV=production:
# NODE_ENV=production
# DATABASE_URL=postgresql://tap_hoa_app:...@db:5432/tap_hoa?schema=public
# PORT=3000
# API_PORT=3040

# Optional: EINVOICE_PROVIDER=http ...
# Optional: FIREBASE_SERVICE_ACCOUNT=C:\secrets\tap-hoa-firebase.json
