DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tap_hoa?schema=public
# Required outside NODE_ENV=development. Generate a strong production value:
# [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }) -as [byte[]])
# apps/api/src/auth/jwt.config.ts rejects missing JWT_SECRET outside development.
JWT_SECRET=dev-change-me
PORT=3000
# Production:
# NODE_ENV=production

# Optional: enable only when issuing real e-invoices through the HTTP gateway
# EINVOICE_PROVIDER=http
# EINVOICE_HTTP_URL=https://...
# EINVOICE_HTTP_API_KEY=<secret>
# EINVOICE_HTTP_TIMEOUT_MS=15000

# Optional: absolute path to Firebase service-account JSON for FCM sends
# FIREBASE_SERVICE_ACCOUNT=C:\secrets\tap-hoa-firebase.json
